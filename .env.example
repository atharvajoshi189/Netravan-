# ==============================================================================
# TigerTraceAI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local deployment.
# Never commit real API keys, passwords, or production secrets to source control.
# ==============================================================================

# Backend API Service
TIGERTRACE_HOST=127.0.0.1
TIGERTRACE_PORT=8000
TIGERTRACE_DEBUG=False

# Compute Platform ('cpu', 'cuda', 'mps')
TIGERTRACE_DEVICE=cpu

# Database Configuration (Relative to workspace root or absolute path)
TIGERTRACE_DB_PATH=TigerTrace_AI/data/database/tigertrace.db

# SMS & Hardware Alert Dispatch (Disabled by default for local offline use)
ENABLE_SMS_ALERTS=False
SMS_DRY_RUN=True
ALERT_PHONE_NUMBER=+919876543210
GAMMU_CONFIG_PATH=

# Modern Web UI Configuration (web_ui)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEV_PORT=3000
